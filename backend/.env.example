# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
# Identity is proven by a signed wallet message (SIWE-style); the JWT below is
# only the post-authentication session token. There are no stored passwords.
JWT_SECRET=replace_with_a_long_random_secret

# Session token lifetime issued after a successful wallet signature
JWT_EXPIRES_IN=1d

# Optional chain id embedded in the sign-in challenge message (display only)
# CHAIN_ID=11155111

# MongoDB Database Connection URL
# Local development loads the repository-root atlas-credentials.env file, which
# is ignored by Git. Hosted deployments should set this in their secret store.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/carechain?retryWrites=true&w=majority
MONGODB_URI=

# Frontend Allowed Origin for CORS
CORS_ORIGIN=http://localhost:3000

# Pinata IPFS Credentials
# Obtain your JWT from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# JSON & Multipart Upload Payload Limit
JSON_LIMIT=10mb
MAX_FILE_SIZE_MB=25

# Seed script (scripts/seedDemoUsers.js): mnemonic used to derive deterministic
# demo wallet identities. Defaults to the well-known Hardhat test mnemonic.
# DEMO_MNEMONIC=test test test test test test test test test test test junk
