# Server Configuration
PORT=10000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=mediblock_super_secret_jwt_key_change_in_production_2026

# MongoDB Database Connection URL
MONGODB_URI=mongodb://127.0.0.1:27017/mediblock
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mediblock?retryWrites=true&w=majority

# Frontend Allowed Origin for CORS
CORS_ORIGIN=http://localhost:3000

# Pinata IPFS Credentials
# Obtain your JWT from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# JSON & Multipart Upload Payload Limit
JSON_LIMIT=10mb
MAX_FILE_SIZE_MB=25
