{
  "name": "carechain-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "CareChain - Enterprise Decentralized Electronic Health Record Protocol",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "test:all": "hardhat test && npm --prefix frontend test -- --watchAll=false",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "hardhat compile && npm --prefix frontend run build"
  },
  "keywords": [
    "carechain",
    "healthcare",
    "ehr",
    "solidity",
    "blockchain",
    "ipfs",
    "ethereum",
    "polygon"
  ],
  "author": "CareChain Core Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.26.5"
  }
}
