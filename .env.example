# Etherscan API Key for contract verification
# Get yours from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Sepolia Network (Ethereum Testnet)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=your_wallet_private_key_here

# Polygon Amoy Network (Polygon Testnet)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# PRIVATE_KEY=your_wallet_private_key_here (same as above)

# MongoDB Atlas (Backend)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/carechain

# Pinata IPFS
# PINATA_JWT=your_pinata_jwt_token_here

# JWT Secret for Backend
# JWT_SECRET=your_jwt_secret_here
